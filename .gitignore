.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Generated by XcodeGen from project.yml — do not commit.
ASRs-R-US.xcodeproj/
prompts-dump/

# Eval data: real dictations from the session log, and the model outputs
# scored against them. Personal speech -- stays on this Mac.
Evals/gold-set.json
Evals/last-run-*.json
Evals/__pycache__/

# Scheduler lock, per-machine.
.claude/scheduled_tasks.lock

# Verbatim-recogniser bench. The harness is committed; nothing it consumes or
# produces is, because all of it is Brian's speech or derived from it -- the
# same reason the gold set and the session log are not in the repo.
#
# Listed as "everything under Evals/verbatim, then un-ignore the scripts",
# rather than naming each output. Naming them meant every new kind of output
# had to be remembered, and opus/ and whisper-out/ were not -- they reached the
# staging area on the first commit that included this directory.
Evals/verbatim/*
!Evals/verbatim/*.py
!Evals/verbatim/*.tpl.html
!Evals/verbatim/README.md
